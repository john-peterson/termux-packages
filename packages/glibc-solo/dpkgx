function install {
	for p in $@; do
		if [[ "$p" != *.deb ]]; then continue; fi
		# dpkgz -I $p|grep Package
		# dpkgz -I $p|grep Package|cut -f3 -d" "
		name=$(dpkgz -I $p|grep Package|cut -f3 -d" ")
		# echo unpacking $name $p | tee -a $log
		dpkg -x $p $root

		echo "processing: install: $name" >&$fd
		# echo "processing: upgrade: $name" >&$fd
		echo "status: $name: half-installed" >&$fd
		echo "status: $name: unpacked" >&$fd

		# echo >> $status
		# echo Package: $name >> $status
		# echo "Status: install ok installed" >> $status
		# echo "Version: 0" >> $status
		
done
}

